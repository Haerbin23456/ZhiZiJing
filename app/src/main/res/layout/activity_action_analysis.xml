<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/zzj_background"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    tools:ignore="HardcodedText">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="32dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp">

        <TextView
            style="@style/ZzjPageTitle"
            android:text="动作实时评估" />

        <LinearLayout
            style="@style/ZzjCard"
            android:layout_marginTop="18dp">

            <TextView
                style="@style/ZzjSectionTitle"
                android:text="训练状态" />

            <TextView
                android:id="@+id/analysisStatusText"
                style="@style/ZzjBodyText"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_zzj_card_soft"
                android:padding="14dp" />
        </LinearLayout>

        <LinearLayout
            style="@style/ZzjCard"
            android:layout_marginTop="16dp">

            <TextView
                style="@style/ZzjSectionTitle"
                android:text="训练控制" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/autoSimulateButton"
                style="@style/ZzjPrimaryButton"
                android:text="开始自动模拟训练" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/simulateSquatButton"
                style="@style/ZzjSecondaryButton"
                android:text="模拟一次深蹲" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/simulateJumpingJackButton"
                style="@style/ZzjSecondaryButton"
                android:text="模拟一次开合跳" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/pauseRemoteTrainingButton"
                style="@style/ZzjSecondaryButton"
                android:text="暂停节点训练" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/finishTrainingButton"
                style="@style/ZzjPrimaryButton"
                android:text="结束训练并查看结果" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/backButton"
                style="@style/ZzjTextButton"
                android:text="返回" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
