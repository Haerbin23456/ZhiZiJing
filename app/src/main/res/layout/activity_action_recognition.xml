<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/zzj_background"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    tools:ignore="HardcodedText">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="32dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp">

        <TextView
            style="@style/ZzjPageTitle"
            android:text="动作姿势识别" />

        <LinearLayout
            style="@style/ZzjCard"
            android:layout_marginTop="18dp">

            <TextView
                android:id="@+id/recognitionStatusText"
                style="@style/ZzjBodyText"
                android:background="@drawable/bg_zzj_card_soft"
                android:padding="14dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/startCameraRecognitionButton"
                style="@style/ZzjPrimaryButton"
                android:text="开始摄像头自动识别" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/openAnalysisButton"
                style="@style/ZzjSecondaryButton"
                android:text="进入主控实时评估" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/backButton"
                style="@style/ZzjTextButton"
                android:text="返回" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
