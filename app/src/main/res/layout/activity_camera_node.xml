<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/black" android:fitsSystemWindows="true" tools:ignore="HardcodedText">

    <!-- 1. 实时相机预览 -->
    <androidx.camera.view.PreviewView android:id="@+id/previewView" android:layout_width="match_parent" android:layout_height="match_parent" app:scaleType="fillCenter" />

    <!-- 2. 姿态检测骨骼遮罩层 -->
    <com.example.zhizijing.pose.overlay.PoseOverlayView android:id="@+id/poseOverlayView" android:layout_width="match_parent" android:layout_height="match_parent" />

    <!-- 3. 顶部与底部暗色渐变阴影（确保任何背景下文字清晰） -->
    <View android:layout_width="match_parent" android:layout_height="180dp" android:layout_gravity="top" android:background="@drawable/bg_camera_top_scrim" />

    <View android:layout_width="match_parent" android:layout_height="280dp" android:layout_gravity="bottom" android:background="@drawable/bg_camera_bottom_scrim" />

    <!-- 4. 顶部控制状态栏（极简单行胶囊设计） -->
    <LinearLayout android:id="@+id/topStatusBar" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="top" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="16dp" android:paddingTop="14dp" android:paddingEnd="16dp">

        <com.google.android.material.button.MaterialButton android:id="@+id/backButton" style="@style/ZzjFloatingIconButton" android:layout_width="48dp" android:layout_height="48dp" android:contentDescription="返回" app:icon="@drawable/ic_back_24" />

        <com.google.android.material.card.MaterialCardView android:layout_width="0dp" android:layout_height="48dp" android:layout_marginStart="10dp" android:layout_marginEnd="10dp" android:layout_weight="1" app:cardBackgroundColor="#CC1C1B1F" app:cardCornerRadius="24dp" app:cardElevation="0dp" app:strokeColor="#25FFFFFF" app:strokeWidth="1dp">

            <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">

                <TextView android:id="@+id/trainingCountdownText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:ellipsize="end" android:maxLines="1" android:text="训练尚未开始" android:textColor="@color/white" android:textSize="14sp" android:textStyle="bold" />

                <!-- 保留 ID 供 Kotlin 绑定，彻底隐藏不占位 -->
                <TextView android:id="@+id/cameraStatusText" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" tools:ignore="MissingConstraints" />
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton android:id="@+id/settingsButton" style="@style/ZzjFloatingIconButton" android:layout_width="48dp" android:layout_height="48dp" android:contentDescription="训练设置" app:icon="@drawable/ic_settings_24" />
    </LinearLayout>

    <!-- 5. 【新增设计】多机位 HUD 监视芯片 (Top Floating HUD) -->
    <com.google.android.material.card.MaterialCardView android:id="@+id/connectionStatusCard" android:layout_width="wrap_content" android:layout_height="32dp" android:layout_gravity="top|center_horizontal" android:layout_marginTop="76dp" app:cardBackgroundColor="#991A1A1A" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:strokeColor="#20FFFFFF" app:strokeWidth="1dp">

        <LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="12dp" android:paddingEnd="12dp">

            <!-- 动态网络状态指示灯（绿色/黄色/灰色），100%纯原生卡片绘制，安全无依赖 -->
            <com.google.android.material.card.MaterialCardView android:id="@+id/connectionStatusDot" android:layout_width="6dp" android:layout_height="6dp" android:layout_marginEnd="6dp" app:cardBackgroundColor="#808080" app:cardCornerRadius="3dp" app:cardElevation="0dp" app:strokeWidth="0dp" />

            <TextView android:id="@+id/connectionStatusText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:text="单机模式" android:textColor="#E0E0E0" android:textSize="11sp" android:textStyle="bold" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 6. 统一底部面板（卡片与控制台垂直堆叠，防重叠） -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:orientation="vertical" android:paddingBottom="16dp">

        <!-- 拟物玻璃态数据卡片（纯粹的运动数据，非常干练） -->
        <com.google.android.material.card.MaterialCardView android:id="@+id/metricsCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:layout_marginBottom="16dp" app:cardBackgroundColor="#E5121212" app:cardCornerRadius="28dp" app:cardElevation="0dp" app:strokeColor="#33FFFFFF" app:strokeWidth="1.5dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:baselineAligned="false" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="24dp" android:paddingTop="20dp" android:paddingEnd="24dp" android:paddingBottom="20dp">

                <!-- 左半部分：次数展示（超大高亮） -->
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.1" android:orientation="vertical">

                    <TextView android:id="@+id/countLabelText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="次数" android:textColor="#80FFFFFF" android:textSize="12sp" android:letterSpacing="0.05" />

                    <TextView android:id="@+id/countValueText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:maxLines="1" android:text="0 次" android:textColor="@color/white" android:textSize="42sp" android:textStyle="bold" />
                </LinearLayout>

                <!-- 中间极细分割线 -->
                <View android:layout_width="1dp" android:layout_height="48dp" android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:background="#1BFFFFFF" />

                <!-- 右半部分：状态与科目信息 -->
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.3" android:orientation="vertical">

                    <!-- 当前运动实时阶段（如：蹲姿 / 合拢 / 站立） -->
                    <TextView android:id="@+id/problemValueText" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:text="待识别" android:textColor="#FFD54F" android:textSize="18sp" android:textStyle="bold" />

                    <!-- 当前运动科目 -->
                    <TextView android:id="@+id/actionValueText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:ellipsize="end" android:maxLines="1" android:text="自动识别" android:textColor="#B3FFFFFF" android:textSize="12sp" />

                    <!-- 运行模式 -->
                    <TextView android:id="@+id/trainingControlHintText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:ellipsize="end" android:maxLines="1" android:text="单机调试" android:textColor="#80FFFFFF" android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 底部控制按钮台 -->
        <FrameLayout android:id="@+id/controlDock" android:layout_width="match_parent" android:layout_height="72dp" android:paddingStart="24dp" android:paddingEnd="24dp">

            <!-- 默认未开始状态的大按钮 -->
            <com.google.android.material.button.MaterialButton android:id="@+id/startTrainingButton" style="@style/ZzjFloatingStartButton" android:layout_width="match_parent" android:layout_height="56dp" android:layout_gravity="center" android:text="开始训练" android:textSize="16sp" android:textStyle="bold" app:cornerRadius="28dp" app:icon="@drawable/ic_play_24" />

            <!-- 运行状态中的暂停/结束控制栏 -->
            <LinearLayout android:id="@+id/activeControlRow" android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_gravity="center" android:gravity="center" android:orientation="horizontal" android:visibility="gone">

                <!-- 暂停按钮 -->
                <com.google.android.material.floatingactionbutton.FloatingActionButton android:id="@+id/pauseRecognitionButton" android:layout_width="56dp" android:layout_height="56dp" android:contentDescription="暂停识别" app:backgroundTint="#0C332B" app:fabCustomSize="56dp" app:maxImageSize="24dp" app:srcCompat="@drawable/ic_pause_24" app:tint="@color/white" />

                <!-- 结束按钮 -->
                <com.google.android.material.floatingactionbutton.FloatingActionButton android:id="@+id/saveTrainingButton" android:layout_width="56dp" android:layout_height="56dp" android:layout_marginStart="24dp" android:contentDescription="结束训练" app:backgroundTint="#421415" app:fabCustomSize="56dp" app:maxImageSize="24dp" app:srcCompat="@drawable/ic_stop_24" app:tint="@color/white" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- 7. 倒计时全屏覆盖层 -->
    <FrameLayout android:id="@+id/countdownOverlay" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#B3000000" android:clickable="true" android:focusable="true" android:visibility="gone">

        <TextView android:id="@+id/countdownNumberText" android:layout_width="140dp" android:layout_height="140dp" android:layout_gravity="center" android:background="@drawable/bg_camera_countdown_number" android:gravity="center" android:text="3" android:textColor="@color/white" android:textSize="72sp" android:textStyle="bold" />
    </FrameLayout>
</FrameLayout>