<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/zzj_background"
    android:fillViewport="true"
    tools:ignore="HardcodedText">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            style="@style/ZzjPageTitle"
            android:text="设备组队" />

        <TextView
            style="@style/ZzjBodyText"
            android:layout_marginTop="8dp"
            android:text="创建房间的主控手机可设置本机和加入手机的正面/侧面机位；加入房间的手机只显示当前机位。" />

        <LinearLayout
            style="@style/ZzjCard"
            android:layout_marginTop="18dp">

            <TextView
                style="@style/ZzjSectionTitle"
                android:text="设备状态" />

            <TextView
                android:id="@+id/deviceListText"
                style="@style/ZzjBodyText"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_zzj_card_soft"
                android:padding="14dp" />
        </LinearLayout>

        <LinearLayout
            style="@style/ZzjCard"
            android:layout_marginTop="16dp">

            <TextView
                style="@style/ZzjSectionTitle"
                android:text="机位分配" />

            <TextView
                android:id="@+id/localRoleText"
                style="@style/ZzjBodyText"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_zzj_card_soft"
                android:padding="14dp"
                android:text="本机当前机位：未分配" />

            <TextView
                android:id="@+id/roleControlHintText"
                style="@style/ZzjBodyText"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_zzj_card_soft"
                android:padding="14dp"
                android:text="主控端负责统一配置机位，同一时间只允许一台正面机位和一台侧面机位。" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/assignSelfFrontButton"
                style="@style/ZzjSecondaryButton"
                android:text="设置本机为正面机位" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/assignSelfSideButton"
                style="@style/ZzjSecondaryButton"
                android:text="设置本机为侧面机位" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/assignJoinedFrontButton"
                style="@style/ZzjSecondaryButton"
                android:text="设置加入手机为正面机位" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/assignJoinedSideButton"
                style="@style/ZzjSecondaryButton"
                android:text="设置加入手机为侧面机位" />
        </LinearLayout>

        <LinearLayout
            style="@style/ZzjCard"
            android:layout_marginTop="16dp">

            <TextView
                style="@style/ZzjSectionTitle"
                android:text="开始训练" />

            <TextView
                style="@style/ZzjBodyText"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_zzj_card_soft"
                android:padding="14dp"
                android:text="进入训练后先调整摄像头画面，点击开始训练会进行 3 秒倒计时，倒计时结束后自动识别动作。" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/enterTrainingButton"
                style="@style/ZzjPrimaryButton"
                android:text="进入训练" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/backButton"
                style="@style/ZzjTextButton"
                android:text="返回" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
