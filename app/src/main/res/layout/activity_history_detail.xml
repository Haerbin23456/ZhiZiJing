<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent" android:background="?attr/colorSurface" android:fillViewport="true" android:fitsSystemWindows="true" tools:ignore="HardcodedText">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="20dp" android:paddingTop="24dp" android:paddingEnd="20dp" android:paddingBottom="24dp">

        <!-- 1. 顶部极简返回状态条 -->
        <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp">

            <TextView style="@style/ZzjPageTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="训练报告" android:textSize="28sp" />

            <TextView android:id="@+id/resultActionText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:layout_centerVertical="true" android:background="@drawable/bg_camera_sync_chip" android:paddingStart="12dp" android:paddingTop="6dp" android:paddingEnd="12dp" android:paddingBottom="6dp" android:textColor="#D7E3DD" android:textSize="12sp" android:textStyle="bold" tools:text="深蹲训练" />
        </RelativeLayout>

        <!-- 2. 【首屏高光 Hero Area】成绩与评分双子星盘（非卡片设计，干净利落） -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" android:orientation="horizontal" android:gravity="center_vertical">

            <!-- 成绩展示 -->
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="总次数" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="13sp" android:letterSpacing="0.05" />

                <TextView android:id="@+id/resultPrimaryMetricText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="?attr/colorPrimary" android:textSize="44sp" android:textStyle="bold" tools:text="12 次" />
            </LinearLayout>

            <!-- 评分圆盘（高对比度 M3 容器） -->
            <com.google.android.material.card.MaterialCardView android:layout_width="wrap_content" android:layout_height="wrap_content" app:cardBackgroundColor="?attr/colorSurfaceContainerHigh" app:cardCornerRadius="20dp" app:cardElevation="0dp" app:strokeColor="#1AFFFFFF" app:strokeWidth="1dp">

                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical" android:paddingStart="20dp" android:paddingTop="12dp" android:paddingEnd="20dp" android:paddingBottom="12dp">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="本次运动评分" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="11sp" />

                    <TextView android:id="@+id/resultScoreText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="#FFD54F" android:textSize="22sp" android:textStyle="bold" tools:text="92 分" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- 3. 【核心推荐】教练实时建议卡片（专属对比底色，引导第一眼阅读） -->
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" app:cardBackgroundColor="?attr/colorTertiaryContainer" app:cardCornerRadius="24dp" app:cardElevation="0dp" app:strokeWidth="0dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="💡 专业动作改进建议" android:textColor="?attr/colorOnTertiaryContainer" android:textSize="13sp" android:textStyle="bold" />

                <TextView android:id="@+id/resultSuggestionText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:lineSpacingExtra="4dp" android:textColor="?attr/colorOnTertiaryContainer" android:textSize="14sp" tools:text="建议：保持膝盖朝向脚尖，下蹲时臀部低于膝盖，继续按稳定节奏完成动作。" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView android:id="@+id/confidenceText" style="@style/ZzjBodyText" android:layout_marginBottom="16dp" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="12sp" tools:text="姿态识别置信度：0.93" />

        <!-- 5. 训练视频回放（影院级圆角播放卡片） -->
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" app:cardBackgroundColor="?attr/colorSurfaceContainerLow" app:cardCornerRadius="24dp" app:cardElevation="0dp" app:strokeColor="?attr/colorOutlineVariant" app:strokeWidth="1dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">

                <TextView style="@style/ZzjSectionTitle" android:text="训练视频回放" />

                <TextView android:id="@+id/videoPlaybackStatusText" style="@style/ZzjBodyText" android:layout_marginTop="8dp" android:text="暂无可回放视频" android:textSize="13sp" />

                <!-- 原生圆角修边卡片，包裹播放器 -->
                <com.google.android.material.card.MaterialCardView android:id="@+id/videoPlayerContainer" android:layout_width="match_parent" android:layout_height="360dp" android:layout_marginTop="10dp" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:strokeWidth="0dp">

                    <TextureView android:id="@+id/videoPlayerView" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" />
                </com.google.android.material.card.MaterialCardView>

                <!-- 紧凑的播放控制板 -->
                <LinearLayout android:id="@+id/videoPlaybackControlRow" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="vertical" android:visibility="gone">

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton android:id="@+id/playPauseVideoButton" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="88dp" android:layout_height="36dp" android:text="播放" android:textSize="12sp" android:insetTop="0dp" android:insetBottom="0dp" app:cornerRadius="18dp" />

                        <TextView android:id="@+id/videoPositionText" style="@style/ZzjBodyText" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:text="00:00 / 00:00" android:textSize="12sp" />
                    </LinearLayout>

                    <SeekBar android:id="@+id/videoSeekBar" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:paddingStart="0dp" android:paddingEnd="0dp" />

                    <!-- 视角快速切换按钮 -->
                    <LinearLayout android:id="@+id/videoSwitchRow" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal" android:visibility="gone">

                        <com.google.android.material.button.MaterialButton android:id="@+id/previousVideoButton" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="36dp" android:layout_marginEnd="6dp" android:layout_weight="1" android:text="正面视角" android:textSize="12sp" android:insetTop="0dp" android:insetBottom="0dp" app:cornerRadius="18dp" />

                        <com.google.android.material.button.MaterialButton android:id="@+id/nextVideoButton" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="36dp" android:layout_marginStart="6dp" android:layout_weight="1" android:text="侧面视角" android:textSize="12sp" android:insetTop="0dp" android:insetBottom="0dp" app:cornerRadius="18dp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 6. 动作复盘建议卡片 -->
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" app:cardBackgroundColor="?attr/colorSurfaceContainerLow" app:cardCornerRadius="24dp" app:cardElevation="0dp" app:strokeColor="?attr/colorOutlineVariant" app:strokeWidth="1dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">

                <TextView style="@style/ZzjSectionTitle" android:text="数据细节深度分析" />

                <TextView android:id="@+id/resultText" style="@style/ZzjBodyText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/bg_zzj_card_soft" android:padding="14dp" android:lineSpacingExtra="4dp" android:textSize="13sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 7. 双机位关键帧复盘卡片 -->
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" app:cardBackgroundColor="?attr/colorSurfaceContainerLow" app:cardCornerRadius="24dp" app:cardElevation="0dp" app:strokeColor="?attr/colorOutlineVariant" app:strokeWidth="1dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">

                <TextView style="@style/ZzjSectionTitle" android:text="多角度关键帧复盘" />

                <TextView android:id="@+id/keyFramePreviewText" style="@style/ZzjBodyText" android:layout_marginTop="6dp" android:text="运动下蹲/打开极限点时的双视角快照" android:textSize="12sp" />

                <!-- 双帧对比布局 -->
                <LinearLayout android:id="@+id/keyFramePreviewContainer" android:layout_width="match_parent" android:layout_height="180dp" android:layout_marginTop="12dp" android:orientation="horizontal" android:visibility="gone">

                    <ImageView android:id="@+id/firstKeyFrameImage" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="6dp" android:layout_weight="1" android:adjustViewBounds="true" android:background="?attr/colorSurfaceContainerHigh" android:contentDescription="正面关键帧" android:padding="4dp" android:scaleType="centerInside" />

                    <ImageView android:id="@+id/secondKeyFrameImage" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="6dp" android:layout_weight="1" android:adjustViewBounds="true" android:background="?attr/colorSurfaceContainerHigh" android:contentDescription="侧面关键帧" android:padding="4dp" android:scaleType="centerInside" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 8. 报告管理区域（全新设计的扁平化操作台） -->
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="18dp" app:cardBackgroundColor="?attr/colorSurfaceContainerLow" app:cardCornerRadius="24dp" app:cardElevation="0dp" app:strokeColor="?attr/colorOutlineVariant" app:strokeWidth="1dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">

                <TextView style="@style/ZzjSectionTitle" android:text="报告与分析导出" />

                <!-- 导出与分享并行排列，大幅节省空间 -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton android:id="@+id/exportPdfButton" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1.2" android:text="生成 PDF" android:textSize="13sp" android:textStyle="bold" app:cornerRadius="22dp" />

                    <com.google.android.material.button.MaterialButton android:id="@+id/sharePdfReportButton" style="@style/Widget.Material3.Button.IconButton" android:layout_width="44dp" android:layout_height="44dp" android:layout_marginStart="8dp" android:contentDescription="分享" app:icon="@android:drawable/ic_menu_share" app:iconTint="?attr/colorOnSecondaryContainer" />
                </LinearLayout>

                <!-- 导出姿态样本 -->
                <com.google.android.material.button.MaterialButton android:id="@+id/exportPoseSampleButton" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="10dp" android:text="导出关键点样本 (.json)" android:textSize="13sp" android:textStyle="bold" app:cornerRadius="22dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
