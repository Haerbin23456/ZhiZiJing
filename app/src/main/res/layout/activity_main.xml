<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:ignore="HardcodedText">

    <FrameLayout
        android:id="@+id/pagesContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/startPage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="ifContentScrolls"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingTop="32dp"
                android:paddingEnd="24dp"
                android:paddingBottom="24dp">

                <TextView
                    android:id="@+id/appTitle"
                    style="@style/ZzjDisplayTitle"
                    android:text="智姿镜" />

                <TextView
                    android:id="@+id/appSummary"
                    style="@style/ZzjBodyLarge"
                    android:layout_marginTop="8dp"
                    android:text="选择项目，开始采集。" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/modeCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:minHeight="112dp"
                    app:cardBackgroundColor="?attr/colorSecondaryContainer"
                    app:cardElevation="0dp"
                    app:rippleColor="?attr/colorOnSecondaryContainer"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.ZhiZiJing.Large"
                    app:strokeColor="?attr/colorOutlineVariant"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:id="@+id/modeTitleText"
                            style="@style/ZzjTitleLarge"
                            android:text="单机训练"
                            android:textColor="?attr/colorOnSecondaryContainer" />

                        <TextView
                            android:id="@+id/modeSummaryText"
                            style="@style/ZzjBodyMedium"
                            android:layout_marginTop="6dp"
                            android:text="正面机位 · 单机"
                            android:textColor="?attr/colorOnSecondaryContainer" />

                        <TextView
                            style="@style/ZzjBodyMedium"
                            android:layout_marginTop="12dp"
                            android:text="点击设置机位"
                            android:textColor="?attr/colorOnSecondaryContainer" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/supportedActionsText"
                    style="@style/ZzjTitleMedium"
                    android:layout_marginTop="32dp"
                    android:text="训练项目" />

                <LinearLayout
                    android:id="@+id/trainingPanel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/hostActionPanel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/startSquatButton"
                            style="@style/ZzjActionButton"
                            android:layout_width="0dp"
                            android:layout_height="104dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:text="深蹲"
                            app:backgroundTint="?attr/colorPrimaryContainer"
                            app:icon="@drawable/ic_squat_24"
                            app:iconGravity="textTop"
                            app:iconPadding="8dp"
                            app:iconTint="?attr/colorOnPrimaryContainer" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/startJumpingJackButton"
                            style="@style/ZzjActionButton"
                            android:layout_width="0dp"
                            android:layout_height="104dp"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:text="开合跳"
                            app:backgroundTint="?attr/colorTertiaryContainer"
                            app:icon="@drawable/ic_jump_24"
                            app:iconGravity="textTop"
                            app:iconPadding="8dp"
                            app:iconTint="?attr/colorOnTertiaryContainer" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/startFollowerButton"
                        style="@style/ZzjPrimaryButton"
                        android:layout_height="64dp"
                        android:layout_marginTop="0dp"
                        android:text="副机采集"
                        android:visibility="gone"
                        app:icon="@drawable/ic_camera_24"
                        app:iconGravity="textStart"
                        tools:visibility="visible" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:id="@+id/historyPage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="32dp"
            android:paddingEnd="24dp"
            android:paddingBottom="16dp"
            android:visibility="gone">

            <TextView
                style="@style/ZzjDisplayTitle"
                android:text="历史记录" />

            <include
                android:id="@+id/homeHistoryListContent"
                layout="@layout/view_history_list"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="18dp"
                android:layout_weight="1" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/settingsPage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="ifContentScrolls"
            android:paddingBottom="16dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingTop="32dp"
                android:paddingEnd="24dp"
                android:paddingBottom="24dp">

                <TextView
                    style="@style/ZzjDisplayTitle"
                    android:text="设置" />

                <TextView
                    style="@style/ZzjBodyLarge"
                    android:layout_marginTop="8dp"
                    android:text="训练模式与应用设置。" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    app:cardBackgroundColor="?attr/colorSurfaceContainer"
                    app:cardElevation="0dp"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.ZhiZiJing.Large"
                    app:strokeColor="?attr/colorOutlineVariant"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            style="@style/ZzjTitleLarge"
                            android:text="偏好" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/settingsButton"
                            style="@style/ZzjPrimaryButton"
                            android:layout_marginTop="16dp"
                            android:text="应用设置"
                            app:icon="@drawable/ic_settings_24"
                            app:iconGravity="textStart" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/logoutButton"
                            style="@style/ZzjTextButton"
                            android:text="退出登录" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/mainNavigationBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurfaceContainer"
        app:itemActiveIndicatorStyle="@style/ZzjNavigationActiveIndicator"
        app:itemIconTint="@color/selector_main_navigation"
        app:itemTextColor="@color/selector_main_navigation"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/menu_main_navigation" />
</LinearLayout>
