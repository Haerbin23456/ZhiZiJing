<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/zzj_background"
    android:fillViewport="true"
    tools:ignore="HardcodedText">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            style="@style/ZzjPageTitle"
            android:text="扫码加入房间" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="360dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_zzj_card_soft"
            android:elevation="2dp"
            android:padding="4dp">

            <androidx.camera.view.PreviewView
                android:id="@+id/previewView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <TextView
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="将主控端二维码放入框内"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />
        </FrameLayout>

        <LinearLayout
            style="@style/ZzjCard"
            android:layout_marginTop="14dp">

            <TextView
                android:id="@+id/scanStatusText"
                style="@style/ZzjBodyText"
                android:background="@drawable/bg_zzj_card_soft"
                android:padding="14dp"
                android:text="正在准备扫码..." />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/restartScanButton"
                style="@style/ZzjPrimaryButton"
                android:text="重新开始扫码" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/backButton"
                style="@style/ZzjTextButton"
                android:text="返回" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
