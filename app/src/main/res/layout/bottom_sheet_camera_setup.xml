<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="false"
    android:overScrollMode="ifContentScrolls"
    android:paddingBottom="16dp"
    tools:ignore="HardcodedText">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="18dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <com.google.android.material.bottomsheet.BottomSheetDragHandleView
            android:id="@+id/dragHandle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="8dp" />

        <TextView
            style="@style/ZzjTitleLarge"
            android:text="多机位配置" />

        <TextView
            android:id="@+id/setupStatusText"
            style="@style/ZzjBodyMedium"
            android:layout_marginTop="6dp"
            android:text="配置这台手机的采集身份，并完成两部手机的配对。" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/setupModeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/singleModeButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:checkable="true"
                android:text="单机模式"
                android:textAllCaps="false" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/hostModeButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:checkable="true"
                android:text="作为主机"
                android:textAllCaps="false" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/nodeModeButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:checkable="true"
                android:text="作为副机"
                android:textAllCaps="false" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <LinearLayout
            android:id="@+id/singleSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical">

            <TextView
                style="@style/ZzjTitleMedium"
                android:text="识别视角" />

            <TextView
                style="@style/ZzjBodyMedium"
                android:layout_marginTop="4dp"
                android:text="选择本机摄像头的采集视角。首页之后选择训练动作。" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/singleFrontButton"
                    style="@style/ZzjSecondaryButton"
                    android:layout_width="0dp"
                    android:layout_marginTop="0dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="正面视角" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/singleSideButton"
                    style="@style/ZzjSecondaryButton"
                    android:layout_width="0dp"
                    android:layout_marginStart="6dp"
                    android:layout_marginTop="0dp"
                    android:layout_weight="1"
                    android:text="侧面视角" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/hostSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                style="@style/ZzjTitleMedium"
                android:text="步骤 1：让副机加入房间" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="房间码"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:minHeight="72dp">

                <TextView
                    android:id="@+id/roomCodeText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:textAppearance="?attr/textAppearanceDisplayMedium"
                    android:textColor="?attr/colorPrimary"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    tools:text="123 456" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/refreshRoomCodeButton"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end|center_vertical"
                    app:icon="@drawable/ic_refresh_24"
                    app:iconTint="?attr/colorPrimary"
                    android:contentDescription="刷新房间码" />
            </FrameLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="20dp"
                app:cardCornerRadius="28dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="@android:color/white">

                <ImageView
                    android:id="@+id/roomQrImage"
                    android:layout_width="184dp"
                    android:layout_height="184dp"
                    android:contentDescription="训练房间二维码"
                    android:padding="8dp"
                    android:scaleType="fitCenter" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/hostConnectionText"
                style="@style/ZzjBodyMedium"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="选择作为主机后会自动创建房间，副机扫描二维码连接。" />

            <TextView
                style="@style/ZzjTitleMedium"
                android:layout_marginTop="22dp"
                android:text="步骤 2：选择本机视角" />

            <TextView
                android:id="@+id/hostRoleHintText"
                style="@style/ZzjBodyMedium"
                android:layout_marginTop="4dp"
                android:text="副机会自动设置为相反视角。" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/hostFrontButton"
                    style="@style/ZzjSecondaryButton"
                    android:layout_width="0dp"
                    android:layout_marginTop="0dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="本机拍正面" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/hostSideButton"
                    style="@style/ZzjSecondaryButton"
                    android:layout_width="0dp"
                    android:layout_marginStart="6dp"
                    android:layout_marginTop="0dp"
                    android:layout_weight="1"
                    android:text="本机拍侧面" />
            </LinearLayout>

            <TextView
                android:id="@+id/hostRoleSummaryText"
                style="@style/ZzjBodyMedium"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_zzj_card_soft"
                android:padding="14dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nodeSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                style="@style/ZzjTitleMedium"
                android:text="连接主机房间" />

            <TextView
                style="@style/ZzjBodyMedium"
                android:layout_marginTop="4dp"
                android:text="推荐扫描主机二维码，扫码成功后会自动加入；手动输入作为备用方式。" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/scanQrButton"
                style="@style/ZzjPrimaryButton"
                android:layout_marginTop="14dp"
                android:text="扫码并加入主机" />

            <TextView
                style="@style/ZzjBodyMedium"
                android:layout_marginTop="16dp"
                android:text="手动输入房间码" />

            <EditText
                android:id="@+id/roomCodeInput"
                style="@style/SettingsTextInput"
                android:hint="输入主机上显示的 6 位房间码"
                android:inputType="number" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/startNodeButton"
                style="@style/ZzjSecondaryButton"
                android:text="手动加入主机" />

            <TextView
                android:id="@+id/nodeStatusText"
                style="@style/ZzjBodyMedium"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_zzj_card_soft"
                android:padding="14dp"
                android:text="尚未加入房间。" />
        </LinearLayout>

        <TextView
            android:id="@+id/helperText"
            style="@style/ZzjBodyMedium"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_zzj_card_soft"
            android:padding="14dp"
            android:text="完成机位配置后回到首页选择训练动作。" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/doneButton"
            style="@style/ZzjPrimaryButton"
            android:layout_marginTop="16dp"
            android:text="确定" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
